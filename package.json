{
	"name": "hydro.sh",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"start": "node scripts/start.mjs",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F @hydro.sh/web dev",
		"dev:server": "turbo -F @hydro.sh/server dev",
		"db:push": "turbo -F @hydro.sh/server db:push",
		"db:studio": "turbo -F @hydro.sh/server db:studio",
		"db:generate": "turbo -F @hydro.sh/server db:generate",
		"db:migrate": "turbo -F @hydro.sh/server db:migrate",
		"prepare": "husky || true",
		"check": "biome check .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome check --apply-unsafe .",
		"taze:update": "npx taze -r",
		"taze:update:write": "npx taze -r -w"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"husky": "^9.1.7",
		"turbo": "^2.11.10"
	},
	"packageManager": "bun@1.4.3",
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"engines": {
		"node": ">=22.14.0",
		"bun": ">=1.2.13"
	},
	"overrides": {
		"esbuild": "^0.28.2",
		"fflate": "^0.8.3",
		"postcss-selector-parser": "^7.1.7"
	}
}
