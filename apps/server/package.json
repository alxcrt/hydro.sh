{
	"name": "@hydro.sh/server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias",
		"typecheck": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run db:migrate && bun run dist/src/index.js",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@hydro.sh/schemas": "workspace:*",
		"@orpc/client": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"@resvg/resvg-js": "^2.6.2",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "^1.7.12",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"pg": "^8.23.1",
		"resend": "^6.34.1",
		"satori": "^0.63.2",
		"stripe": "^23.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"tsc-alias": "^1.9.9",
		"typescript": "^6"
	}
}
